# -----------------------------------------------------------------------------
# CarTrade Node.js SDK / REST API
# Copy this file to .env and replace every value that is environment-specific.
# Never commit the real .env or private keys.
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CHANNEL_NAME=cartrade-channel
VEHICLE_CHAINCODE=vehicle
ERC20_CHAINCODE=erc20
WALLET_PATH=./wallet

# Optional: allow the API to create/register identities through Fabric CA.
# Set to true only when CA URLs and registrar/admin credentials are configured.
IDENTITY_REGISTRATION_ENABLED=true

# -----------------------------------------------------------------------------
# Org1 - Dealer
# -----------------------------------------------------------------------------
ORG1_MSP_ID=Org1MSP
ORG1_CA_NAME=ca-org1
ORG1_CA_URL=https://localhost:7054
ORG1_CA_TLS_CERT_PATH=/fabric-network/organizations/fabric-ca/org1/tls-cert.pem
ORG1_ADMIN_CERT_PATH=/fabric-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/signcerts/cert.pem
ORG1_ADMIN_KEY_PATH=/fabric-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/keystore/priv_sk
ORG1_AFFILIATION=org1.department1
ORG1_PEER_ENDPOINT=localhost:7051
ORG1_PEER_HOST_ALIAS=peer0.org1.example.com
ORG1_PEER_TLS_CERT_PATH=/fabric-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt

# -----------------------------------------------------------------------------
# Org2 - Buyer
# -----------------------------------------------------------------------------
ORG2_MSP_ID=Org2MSP
ORG2_CA_NAME=ca-org2
ORG2_CA_URL=https://localhost:8054
ORG2_CA_TLS_CERT_PATH=/fabric-network/organizations/fabric-ca/org2/tls-cert.pem
ORG2_ADMIN_CERT_PATH=/fabric-network/organizations/peerOrganizations/org2.example.com/users/Admin@org2.example.com/msp/signcerts/cert.pem
ORG2_ADMIN_KEY_PATH=/fabric-network/organizations/peerOrganizations/org2.example.com/users/Admin@org2.example.com/msp/keystore/priv_sk
ORG2_AFFILIATION=org2.department1
ORG2_PEER_ENDPOINT=localhost:9051
ORG2_PEER_HOST_ALIAS=peer0.org2.example.com
ORG2_PEER_TLS_CERT_PATH=/fabric-network/organizations/peerOrganizations/org2.example.com/peers/peer0.org2.example.com/tls/ca.crt

# -----------------------------------------------------------------------------
# Org3 - Vehicle Inspector
# -----------------------------------------------------------------------------
ORG3_MSP_ID=Org3MSP
ORG3_CA_NAME=ca-org3
ORG3_CA_URL=https://localhost:9054
ORG3_CA_TLS_CERT_PATH=/fabric-network/organizations/fabric-ca/org3/tls-cert.pem
ORG3_ADMIN_CERT_PATH=/fabric-network/organizations/peerOrganizations/org3.example.com/users/Admin@org3.example.com/msp/signcerts/cert.pem
ORG3_ADMIN_KEY_PATH=/fabric-network/organizations/peerOrganizations/org3.example.com/users/Admin@org3.example.com/msp/keystore/priv_sk
ORG3_AFFILIATION=org3.department1
ORG3_PEER_ENDPOINT=localhost:10051
ORG3_PEER_HOST_ALIAS=peer0.org3.example.com
ORG3_PEER_TLS_CERT_PATH=/fabric-network/organizations/peerOrganizations/org3.example.com/peers/peer0.org3.example.com/tls/ca.crt

# -----------------------------------------------------------------------------
# API defaults / safety
# -----------------------------------------------------------------------------
DEFAULT_FABRIC_IDENTITY=dealer
FABRIC_GATEWAY_EVALUATE_TIMEOUT_MS=5000
FABRIC_GATEWAY_ENDORSE_TIMEOUT_MS=15000
FABRIC_GATEWAY_SUBMIT_TIMEOUT_MS=15000
FABRIC_GATEWAY_COMMIT_TIMEOUT_MS=60000
